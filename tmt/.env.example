# Public application URLs
BRAND_NAME="TMT Services"
PUBLIC_WEB_BASE_URL=
PUBLIC_VOICE_BASE_URL=
HOST=0.0.0.0
PORT=3001

# Anthropic (server only)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT_LIVE=low
AGENT_EFFORT_OFFLINE=medium
AGENT_FAST_MODE=false

# Twilio (server only unless noted)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER_GENERAL=
TWILIO_NUMBER_PA=
TWILIO_NUMBER_HI=
TWILIO_NUMBER_ES=
TWILIO_MESSAGING_SERVICE_SID=
ON_CALL_FALLBACK_E164=

# Recording and retention
RECORDING_ENABLED=false
RECORDING_RETENTION_DAYS=30
UTTERANCE_RETENTION_DAYS=180
JOB_LINK_TTL_HOURS=72

# Supabase. The NEXT_PUBLIC values are the publishable/anon values used by web.
# Keep the service-role key on the server and never reference it in apps/web.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web test fixtures. Unset normally. The only accepted value is "test", and
# apps/web refuses fixture mode when NODE_ENV=production.
TMT_WEB_FIXTURE_MODE=

# Google Maps. Restrict server and browser keys independently.
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Stripe. Use test-mode keys until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability
SENTRY_DSN=
